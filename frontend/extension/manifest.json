{
  "manifest_version": 3,
  "version": "1.0.0",
  "name": "uBlockAI",
  "short_name": "uBlockAI",
  "description": "Blocks AI-generated misinformation in social media feeds.",
  "permissions": ["storage", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://hack-ncstate-2026.onrender.com/*",
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "uBlockAI"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["crime-scene.png"],
      "matches": ["https://www.instagram.com/*"]
    }
  ]
}
